# Local environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets (never commit free-account credentials)
.env
credentials*
*_key.txt

# Heavy / regenerable data (NFR-7: downloaded by script, never committed)
data/raw/*
data/processed/*
data/synthetic/*
data/scenarios/*/data/*
*.nc

# Baseline/forecast run reports (regenerated by scripts; may embed local paths)
data/baselines/
data/forecast/
data/routing/
data/tradeoff/
data/explanation/
data/rerouting/
data/backtest/
data/iceberg/
data/environment/
data/hazard/
data/uncertainty/
data/vessel/

# Frontend build artifacts + dependencies
frontend/node_modules/
frontend/dist/

# Freebuff preview tooling (thread-local)
.freebuff/
scripts/preview/

# Keep directory placeholders tracked
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep